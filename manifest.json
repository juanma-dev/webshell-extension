{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "0.2.0",
  "description": "__MSG_appDesc__",
  "default_locale": "en",
  "permissions": ["storage", "notifications", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "commands": {
    "toggle-terminal": {
      "suggested_key": { "default": "Alt+W" },
      "description": "__MSG_toggleCommandDesc__"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/dom-utils.js",
        "content/storage.js",
        "content/commands.js",
        "content/parser.js",
        "content/picker.js",
        "content/terminal.js"
      ],
      "css": ["content/terminal.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "__MSG_actionTitle__"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
