{
  "manifest_version": 3,
  "name": "WebShell — terminal, scraper y CSV para cualquier página",
  "version": "0.1.0",
  "description": "Una terminal estilo Unix dentro de cualquier página web: extrae datos a CSV, manipula el DOM y monitorea cambios con comandos.",
  "permissions": ["storage", "notifications", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "commands": {
    "toggle-terminal": {
      "suggested_key": { "default": "Alt+W" },
      "description": "Abrir/cerrar la terminal WebShell"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/dom-utils.js",
        "content/commands.js",
        "content/parser.js",
        "content/terminal.js"
      ],
      "css": ["content/terminal.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "WebShell — abre la terminal (Alt+W)"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
